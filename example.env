VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
# Public key from the Developer Portal (General Information); verifies /leaderboard requests
DISCORD_PUBLIC_KEY=YOUR_DISCORD_PUBLIC_KEY_HERE
# Optional: where battle sessions, streaks and win/loss totals are stored (default: data/dailyred.sqlite, relative to server/)
# DB_PATH=/var/lib/dailyred/dailyred.sqlite

# --- Optional server settings ---
# TRUST_PROXY=1                  # reverse proxies in front of the server (for real client IPs)
# RATE_LIMIT_IP_PER_MIN=600      # per-IP flood guard; keep generous behind Discord's proxy
# SESSION_IDLE_MINUTES=30        # unused battles are dropped from memory, then reloaded on demand
# DB_BACKUP_DIR=/data/backups    # daily SQLite backup into this directory
# DB_BACKUP_KEEP=7               # how many backups to keep
