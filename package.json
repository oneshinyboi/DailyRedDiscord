{
  "name": "dailyreddiscord-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:client:local": "VITE_DEV_AUTH=1 npm run dev -w client",
    "dev:server:local": "DEV_AUTH=1 npm run dev -w server",
    "build": "npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w client",
    "start": "npm run start -w server",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
